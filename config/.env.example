# ==============================================================================
# Linux Inventory Manager - Environment Configuration
# ==============================================================================
# Copy this file to .env and update values for your environment.
# NEVER commit .env to version control.

# ─── Application ─────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
APP_NAME=Linux Inventory Manager

# ─── Server ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=4

# ─── Security ────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE-ME-USE-STRONG-RANDOM-VALUE
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480
JWT_REFRESH_EXPIRATION_DAYS=7

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["https://your-domain.com"]
ALLOWED_HOSTS=["your-domain.com"]

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite (default)
DATABASE_URL=sqlite+aiosqlite:///storage/inventory.db
# PostgreSQL (future)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/linuxinventory
DATABASE_ECHO=false

# ─── SSH ─────────────────────────────────────────────────────────────────────
SSH_CONNECTION_TIMEOUT=30
SSH_COMMAND_TIMEOUT=60
SSH_MAX_POOL_SIZE=50
SSH_IDLE_TIMEOUT=300
SSH_MAX_RETRIES=3
SSH_RETRY_DELAY=5

# ─── Scheduler ───────────────────────────────────────────────────────────────
SCHEDULER_ENABLED=true
SCHEDULER_COLLECTION_HOUR=2
SCHEDULER_COLLECTION_MINUTE=0
SCHEDULER_RETRY_INTERVAL_MINUTES=60
SCHEDULER_MAX_CONCURRENT_COLLECTIONS=20

# ─── Secrets Provider ────────────────────────────────────────────────────────
# Options: aws_secrets_manager, local
SECRETS_PROVIDER=aws_secrets_manager
AWS_REGION=us-east-1
# AWS_PROFILE=your-profile  # Optional, uses instance role by default

# ─── Storage ─────────────────────────────────────────────────────────────────
# STORAGE_BASE_PATH=/opt/linux-inventory-manager/storage
# SNAPSHOTS_PATH=/opt/linux-inventory-manager/storage/snapshots
# REPORTS_PATH=/opt/linux-inventory-manager/storage/reports

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
# LOG_DIR=/opt/linux-inventory-manager/logs
LOG_MAX_SIZE_MB=50
LOG_BACKUP_COUNT=10

# ─── Notifications ───────────────────────────────────────────────────────────
SMTP_HOST=smtp.company.com
SMTP_PORT=587
SMTP_USERNAME=linux-inventory@company.com
SMTP_PASSWORD_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:smtp-password
SMTP_FROM_ADDRESS=linux-inventory@company.com
SMTP_USE_TLS=true

# ─── Retention ───────────────────────────────────────────────────────────────
REPORT_RETENTION_DAYS=90
SNAPSHOT_RETENTION_DAYS=365

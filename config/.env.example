# ==============================================================================
# Linux Inventory Manager - Environment Configuration
# ==============================================================================
# Copy this file to .env and update values for your environment.
# NEVER commit .env to version control.
#
# SENSITIVE VALUES:
# The following must be stored in AWS Secrets Manager (NOT in this file):
#   - SSH Private Keys → stored via Credential Profiles (secret_arn)
#   - SMTP Password → SMTP_PASSWORD_SECRET_ARN references it
#   - JWT Secret Key → SECRET_KEY_SECRET_ARN (recommended) or SECRET_KEY
#   - Future DB passwords → if migrating to PostgreSQL
#
# This .env file contains ONLY non-sensitive configuration.
# The only exception is SECRET_KEY which can be set here for dev but
# SHOULD use Secrets Manager in production.
# ==============================================================================

# ─── Application ─────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
APP_NAME=Linux Inventory Manager

# ─── Server ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=4

# ─── Security ────────────────────────────────────────────────────────────────
# OPTION 1 (Recommended): Store in Secrets Manager and reference ARN
# SECRET_KEY_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:linux-inventory/jwt-key
#
# OPTION 2 (Dev only): Set directly (NEVER use in production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE-ME-USE-STRONG-RANDOM-VALUE

JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480
JWT_REFRESH_EXPIRATION_DAYS=7

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["https://your-domain.com"]
ALLOWED_HOSTS=["your-domain.com"]

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite (default - no password needed)
DATABASE_URL=sqlite+aiosqlite:///storage/inventory.db
# PostgreSQL (future - password should be in Secrets Manager)
# DATABASE_URL_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:linux-inventory/db-url
DATABASE_ECHO=false

# ─── SSH ─────────────────────────────────────────────────────────────────────
SSH_CONNECTION_TIMEOUT=30
SSH_COMMAND_TIMEOUT=60
SSH_MAX_POOL_SIZE=50
SSH_IDLE_TIMEOUT=300
SSH_MAX_RETRIES=3
SSH_RETRY_DELAY=5

# ─── Scheduler ───────────────────────────────────────────────────────────────
SCHEDULER_ENABLED=true
SCHEDULER_COLLECTION_HOUR=2
SCHEDULER_COLLECTION_MINUTE=0
SCHEDULER_RETRY_INTERVAL_MINUTES=60
SCHEDULER_MAX_CONCURRENT_COLLECTIONS=20

# ─── Secrets Provider ────────────────────────────────────────────────────────
# Options: aws_secrets_manager, local (dev only)
SECRETS_PROVIDER=aws_secrets_manager
AWS_REGION=us-east-1
# AWS_PROFILE=your-profile  # Optional, uses EC2 instance role by default

# ─── Storage ─────────────────────────────────────────────────────────────────
STORAGE_BASE_PATH=/opt/linux-inventory-manager/storage
SNAPSHOTS_PATH=/opt/linux-inventory-manager/storage/snapshots
REPORTS_PATH=/opt/linux-inventory-manager/storage/reports
EXPORTS_PATH=/opt/linux-inventory-manager/storage/exports

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=/opt/linux-inventory-manager/logs
LOG_MAX_SIZE_MB=50
LOG_BACKUP_COUNT=10

# ─── Notifications ───────────────────────────────────────────────────────────
SMTP_HOST=smtp.company.com
SMTP_PORT=587
SMTP_USERNAME=linux-inventory@company.com
# SMTP password stored in Secrets Manager (never in this file)
SMTP_PASSWORD_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:linux-inventory/smtp-password
SMTP_FROM_ADDRESS=linux-inventory@company.com
SMTP_USE_TLS=true

# ─── Retention ───────────────────────────────────────────────────────────────
REPORT_RETENTION_DAYS=90
SNAPSHOT_RETENTION_DAYS=365

# ─── CMDB Import (EFS-mounted CSV) ───────────────────────────────────────────
CMDB_IMPORT_ENABLED=true
CMDB_IMPORT_PATH=/mnt/efs/cmdb/ec2_inventory.csv
CMDB_IMPORT_SCHEDULE_HOUR=1
CMDB_IMPORT_SCHEDULE_MINUTE=0

# CSV format settings
CMDB_CSV_DELIMITER=,
CMDB_CSV_ENCODING=utf-8
CMDB_CSV_HAS_HEADER=true

# Column mapping (match your CSV headers exactly)
CMDB_COL_REGION=region
CMDB_COL_ACCOUNT_NAME=account_name
CMDB_COL_INSTANCE_ID=instance_id
CMDB_COL_INSTANCE_IP=instance_ip
CMDB_COL_NAME=Name
CMDB_COL_APP_NAME=app_name
CMDB_COL_PDO=PDO

# Default profile assigned to newly imported servers
CMDB_DEFAULT_CREDENTIAL_PROFILE=your-credential-profile-id-here
CMDB_DEFAULT_SSH_PORT=22

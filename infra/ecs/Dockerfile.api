# ==============================================================================
# Linux Inventory Manager - Web API Container
# ==============================================================================
# Serves the FastAPI backend + React frontend via Nginx.
# This container handles: REST APIs, authentication, scheduling triggers,
# and frontend static files.
#
# It does NOT run SSH collectors directly — those run in separate
# collector worker containers for isolation and independent scaling.
# ==============================================================================

# ─── Stage 1: Frontend Build ─────────────────────────────────────────────────
FROM node:20-alpine AS frontend-builder
WORKDIR /app/frontend
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci --production=false
COPY frontend/ ./
RUN npm run build

# ─── Stage 2: Python API ─────────────────────────────────────────────────────
FROM python:3.12-slim AS production

# Security: non-root user
RUN groupadd -r appuser && useradd -r -g appuser -d /app appuser

WORKDIR /app

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libffi-dev curl \
    && rm -rf /var/lib/apt/lists/*

# Python dependencies
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Application code
COPY backend/ ./backend/
COPY config/ ./config/
COPY alembic.ini ./

# Built frontend
COPY --from=frontend-builder /app/frontend/dist ./frontend/dist

# Create directories (EFS will be mounted at /app/storage)
RUN mkdir -p /app/storage /app/logs \
    && chown -R appuser:appuser /app

USER appuser

EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8000/api/v1/health || exit 1

# Start with Uvicorn
CMD ["uvicorn", "backend.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--workers", "2", \
     "--log-level", "info", \
     "--access-log"]

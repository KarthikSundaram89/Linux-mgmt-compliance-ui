# ==============================================================================
# Linux Inventory Manager - Collector Worker Container
# ==============================================================================
# Runs inventory collection workers that:
# 1. Consume collection jobs from SQS
# 2. SSH into Linux servers and run collectors
# 3. Store snapshots to EFS
# 4. Write results to PostgreSQL
# 5. Detect changes and generate notifications
#
# This container is scaled independently from the API.
# Can run 1-N instances depending on queue depth.
# ==============================================================================

FROM python:3.12-slim

# Security: non-root user
RUN groupadd -r collector && useradd -r -g collector -d /app collector

WORKDIR /app

# System dependencies (SSH client for host key scanning)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libffi-dev openssh-client curl \
    && rm -rf /var/lib/apt/lists/*

# Python dependencies
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Application code (only what collectors need)
COPY backend/ ./backend/
COPY config/ ./config/

# Create directories (EFS mounted at /app/storage)
RUN mkdir -p /app/storage /app/logs /app/.ssh \
    && chown -R collector:collector /app

USER collector

# Health check - collector reports health via a simple HTTP endpoint
HEALTHCHECK --interval=60s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8001/health || exit 1

# Start the collector worker process
CMD ["python", "-m", "backend.workers.collector_worker"]

# ==============================================================================
# ECS Production Environment Variables (non-sensitive)
# ==============================================================================
# Sensitive values (SECRET_KEY, DATABASE_URL) are injected from
# AWS Secrets Manager via ECS task definition "secrets" block.
# ==============================================================================

ENVIRONMENT=production
DEBUG=false
APP_NAME=Linux Inventory Manager
HOST=0.0.0.0
PORT=8000
WORKERS=2

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ─── Scheduler (API container only) ──────────────────────────────────────────
SCHEDULER_ENABLED=true
SCHEDULER_COLLECTION_HOUR=2
SCHEDULER_COLLECTION_MINUTE=0
SCHEDULER_RETRY_INTERVAL_MINUTES=60
SCHEDULER_MAX_CONCURRENT_COLLECTIONS=20

# ─── SSH ──────────────────────────────────────────────────────────────────────
SSH_CONNECTION_TIMEOUT=30
SSH_COMMAND_TIMEOUT=60
SSH_MAX_POOL_SIZE=25
SSH_IDLE_TIMEOUT=300
SSH_MAX_RETRIES=3
SSH_RETRY_DELAY=5

# ─── Secrets ──────────────────────────────────────────────────────────────────
SECRETS_PROVIDER=aws_secrets_manager
AWS_REGION=us-east-1

# ─── Storage (EFS mount point) ───────────────────────────────────────────────
STORAGE_BASE_PATH=/app/storage
SNAPSHOTS_PATH=/app/storage/snapshots
REPORTS_PATH=/app/storage/reports
EXPORTS_PATH=/app/storage/exports

# ─── Retention ────────────────────────────────────────────────────────────────
SNAPSHOT_RETENTION_DAYS=365
REPORT_RETENTION_DAYS=90

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480
JWT_REFRESH_EXPIRATION_DAYS=7

# ─── CORS (update with your ALB/domain) ──────────────────────────────────────
CORS_ORIGINS=["https://inventory.yourcompany.com"]

{
  "serviceName": "linux-inventory-api",
  "taskDefinition": "linux-inventory-api",
  "desiredCount": 2,
  "launchType": "FARGATE",
  "platformVersion": "LATEST",
  "deploymentConfiguration": {
    "maximumPercent": 200,
    "minimumHealthyPercent": 100,
    "deploymentCircuitBreaker": {
      "enable": true,
      "rollback": true
    }
  },
  "networkConfiguration": {
    "awsvpcConfiguration": {
      "subnets": ["${PRIVATE_SUBNET_1}", "${PRIVATE_SUBNET_2}"],
      "securityGroups": ["${API_SECURITY_GROUP}"],
      "assignPublicIp": "DISABLED"
    }
  },
  "loadBalancers": [
    {
      "targetGroupArn": "${ALB_TARGET_GROUP_ARN}",
      "containerName": "api",
      "containerPort": 8000
    }
  ],
  "healthCheckGracePeriodSeconds": 60,
  "enableExecuteCommand": true,
  "propagateTags": "TASK_DEFINITION",
  "tags": [
    { "key": "Application", "value": "linux-inventory-manager" },
    { "key": "Component", "value": "api" }
  ]
}

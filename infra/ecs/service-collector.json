{
  "serviceName": "linux-inventory-collector",
  "taskDefinition": "linux-inventory-collector",
  "desiredCount": 1,
  "launchType": "FARGATE",
  "platformVersion": "LATEST",
  "deploymentConfiguration": {
    "maximumPercent": 200,
    "minimumHealthyPercent": 100,
    "deploymentCircuitBreaker": {
      "enable": true,
      "rollback": true
    }
  },
  "networkConfiguration": {
    "awsvpcConfiguration": {
      "subnets": ["${PRIVATE_SUBNET_1}", "${PRIVATE_SUBNET_2}"],
      "securityGroups": ["${COLLECTOR_SECURITY_GROUP}"],
      "assignPublicIp": "DISABLED"
    }
  },
  "enableExecuteCommand": true,
  "propagateTags": "TASK_DEFINITION",
  "tags": [
    { "key": "Application", "value": "linux-inventory-manager" },
    { "key": "Component", "value": "collector" }
  ]
}

{
  "family": "linux-inventory-collector",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "2048",
  "memory": "4096",
  "executionRoleArn": "${COLLECTOR_EXECUTION_ROLE_ARN}",
  "taskRoleArn": "${COLLECTOR_TASK_ROLE_ARN}",
  "containerDefinitions": [
    {
      "name": "collector",
      "image": "${ECR_REPO_URI}:collector-latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8001,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "ENVIRONMENT", "value": "production" },
        { "name": "LOG_FORMAT", "value": "json" },
        { "name": "LOG_LEVEL", "value": "INFO" },
        { "name": "SQS_QUEUE_URL", "value": "${SQS_QUEUE_URL}" },
        { "name": "SECRETS_PROVIDER", "value": "aws_secrets_manager" },
        { "name": "AWS_REGION", "value": "${AWS_REGION}" },
        { "name": "SCHEDULER_MAX_CONCURRENT_COLLECTIONS", "value": "20" },
        { "name": "SSH_CONNECTION_TIMEOUT", "value": "30" },
        { "name": "SSH_COMMAND_TIMEOUT", "value": "60" },
        { "name": "SSH_MAX_POOL_SIZE", "value": "25" },
        { "name": "STORAGE_BASE_PATH", "value": "/app/storage" },
        { "name": "SNAPSHOTS_PATH", "value": "/app/storage/snapshots" }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "${DATABASE_URL_ARN}"
        }
      ],
      "mountPoints": [
        {
          "sourceVolume": "efs-storage",
          "containerPath": "/app/storage",
          "readOnly": false
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:8001/health || exit 1"],
        "interval": 60,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/linux-inventory/collector",
          "awslogs-region": "${AWS_REGION}",
          "awslogs-stream-prefix": "collector",
          "awslogs-create-group": "true"
        }
      },
      "linuxParameters": {
        "initProcessEnabled": true
      },
      "stopTimeout": 120
    }
  ],
  "volumes": [
    {
      "name": "efs-storage",
      "efsVolumeConfiguration": {
        "fileSystemId": "${EFS_FILE_SYSTEM_ID}",
        "rootDirectory": "/linux-inventory",
        "transitEncryption": "ENABLED",
        "authorizationConfig": {
          "accessPointId": "${EFS_ACCESS_POINT_ID}",
          "iam": "ENABLED"
        }
      }
    }
  ],
  "tags": [
    { "key": "Application", "value": "linux-inventory-manager" },
    { "key": "Component", "value": "collector" }
  ]
}
